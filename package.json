{
  "name": "mdrrmo-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "MDRRMO Pio Duran Dashboard - Full Stack Application",
  "keywords": [
    "disaster-management",
    "mdrrmo",
    "dashboard",
    "fastapi",
    "react",
    "mongodb"
  ],
  "license": "MIT",
  "author": "MDRRMO Pio Duran",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "build": "cd frontend && yarn build",
    "clean:all": "cd frontend && rm -rf node_modules build .cache && cd ../backend && rm -rf __pycache__",
    "clean:cache": "cd frontend && rm -rf node_modules/.cache build .cache",
    "freeze:backend": "cd backend && pip freeze > requirements.txt",
    "install:all": "yarn install:backend && yarn install:frontend",
    "install:backend": "cd backend && pip install -r requirements.txt",
    "install:frontend": "cd frontend && yarn install",
    "logs:backend": "tail -f /var/log/supervisor/backend.*.log",
    "logs:frontend": "tail -f /var/log/supervisor/frontend.*.log",
    "restart:all": "sudo supervisorctl restart all",
    "restart:backend": "sudo supervisorctl restart backend",
    "restart:frontend": "sudo supervisorctl restart frontend",
    "status": "sudo supervisorctl status",
    "test:backend": "curl http://localhost:8001/api/health"
  },
